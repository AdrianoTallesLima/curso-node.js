<div class="thought-form-container">
  <a href="/thoughts/dashboard">Voltar</a>
  <h1>Criando um Pensamento:</h1>
  <form action="/thoughts/add" method="POST">
    <div class="form-control">
      <label for="title">Pensamentos</label>
      <input type="text" name="title" placeholder="Digite o seu pensamento...">
    </div>
    <input type="submit" value="Postar Pensamento">
  </form>
</div>